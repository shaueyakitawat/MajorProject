# ==============================================================================
# QUANTITATIVE PIPELINE CONFIGURATION
# ==============================================================================
# Number of hidden states for the HMM volatility regime classifier
REGIME_STATE_COUNT=4

# Volatility fusion weights (sum should ideally be 1.0)
VOL_FUSION_DAILY_WEIGHT=0.7
VOL_FUSION_INTRADAY_WEIGHT=0.3

# Rolling window for calculating Variance Risk Premium (VRP)
VRP_ROLLING_WINDOW=60

# Default annualized risk-free rate (e.g., 6.5% = 0.065)
RISK_FREE_RATE=0.065

# Number of strikes out-of-the-money to fetch for full option chain
STRIKE_EXPANSION=15

# ==============================================================================
# APPLICATION SETTINGS
# ==============================================================================
PORT=8000
LOG_LEVEL=info

# Paper-trader execution safeguards
NIFTY_LOT_SIZE=65
MAX_CONTRACT_POSITIONS=1
MAX_ABS_NET_DELTA=100
MAX_CHAIN_AGE_SECONDS=30
MAX_ENTRY_DEV_PCT=20
MAX_STOP_LOSS_PCT=22
MIN_SURFACE_PEERS=3
DELTA_NEUTRAL_MODE=0
# Set only for offline replay; live trading rejects DB fallback chains by default.
ALLOW_STALE_CHAIN=0
